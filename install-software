#!/usr/bin/env bash
# install-software: apps that live outside dnf (third-party installers,
# flatpaks). Idempotent -- rerunning installs nothing twice.
# Needs an interactive terminal: the installers below call sudo/dnf.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DRY_RUN=0

# shellcheck disable=SC1091
. "$REPO_DIR/scripts/lib.sh"

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        -y|--yes) : ;;  # already non-interactive; accepted for dots apps --yes
        -h|--help) echo "usage: install-software [--dry-run]"; exit 0 ;;
        *) echo "install-software: unknown flag $arg" >&2; exit 2 ;;
    esac
done

if [ "$DRY_RUN" -eq 0 ] && ! sudo -n true 2>/dev/null; then
    if [ ! -t 0 ]; then
        echo "install-software: needs an interactive terminal (sudo asks for a password)" >&2
        exit 1
    fi
    sudo -v || exit 1
fi

have_flatpak() { flatpak info "$1" >/dev/null 2>&1; }

install_brave() {
    if have brave-browser || have brave || have brave-origin; then
        echo "brave: already installed"
        return 0
    fi
    echo "brave: installing (origin flavour)..."
    # Vendor installer, unpinned by nature (dl.brave.com serves latest).
    # Runs as your user here, but escalates internally for repo setup —
    # inspect https://dl.brave.com/install.sh before running on a machine
    # you care about.
    if [ "$DRY_RUN" -eq 1 ]; then
        echo "would run: curl -fsS https://dl.brave.com/install.sh | FLAVOR=origin sh"
    else
        curl -fsS https://dl.brave.com/install.sh | FLAVOR=origin sh
    fi
}

install_flathub() {
    if flatpak remotes 2>/dev/null | grep -qi "^flathub"; then
        echo "flathub: already added"
        return 0
    fi
    echo "flathub: adding remote..."
    run sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
}

install_flatpak_app() {
    if have_flatpak "$1"; then
        echo "$2: already installed"
        return 0
    fi
    echo "$2: installing from flathub..."
    run sudo flatpak install -y flathub "$1"
}

install_brave
install_flathub
install_flatpak_app app.zen_browser.zen "zen browser"
install_flatpak_app com.obsproject.Studio "obs studio"

echo "install-software: done"
