# Runtime / generated state
.cache/
cache/
*.log
*.pyc
__pycache__/

# Secrets
.env
.env.*
*.pem
*.key
credentials*
secrets*

# Editors / OS
.DS_Store
*.swp
*.swo
*~

# Generated archives
*.tar
*.tar.gz
*.zip

# Machine-local artifacts
# Quickshell regenerates this per-run, pointing into /run/user/<uid>/quickshell/vfs/...
.qmlls.ini

# Generated by hypr/hyprlock.lua on every startup. ~/.config/hypr is a
# symlink to hypr/, so the generated file lands in the worktree; it is
# build output, not source. The .lua is what should be edited.
hypr/hyprlock.conf

# Generated by quickshell/scripts/publish-colors.py from
# colors/themes/<theme>/colors.json, and rewritten by the shell on every
# start. They were tracked, which meant every theme switch left the tree
# dirty and a `git checkout` reverted the live desktop's colours until the
# next switch. Theme.qml publishes on startup, so they are always present.
colors/colors.css
colors/colors.sh
colors/current.json
colors/gtk.css
colors/hyprland.conf
colors/kitty.conf

# Runtime discovery cache. quickshell/scripts/list-themes.py and
# publish-colors.py rewrite wallpaperDir/current with $HOME-specific paths
# on every run; the portable template is colors/index.json.example.
colors/index.json

images
todos.md
