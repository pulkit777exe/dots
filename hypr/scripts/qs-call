#!/usr/bin/env python3
"""Call a Quickshell IpcHandler function over its IPC socket, without
paying for a `quickshell` process launch.

Why this exists
---------------
`quickshell ipc call` costs ~54ms on this machine, and ~40ms of that is the
client's own startup -- `quickshell --version` alone takes 40ms, because it
is a Qt binary and links the world before it parses argv. The shell's IPC
socket is a plain Unix stream socket that is already listening, so a keybind
does not need to launch a second Qt process to reach it.

Usage
-----
    qs-call <target> <function> [args...]
    qs-call show                 # list targets and their functions

Wire format
-----------
Reverse-engineered by proxying the real client against the live socket and
reading the bytes, because there is no documentation for it. It is a
Qt QDataStream, not text:

    u32le   stream version: 3 for a call request, 5 for a reply
    then, repeated:
      u8    byte length of the string that follows (NOT a character count)
      ...   that many bytes of UTF-16BE

Three details that are easy to get wrong and were each wrong in a first
attempt at this file:

  * The length is a u8, and it counts BYTES. "isSettingsOpen" is 14
    characters and its prefix is 0x1c = 28, not 14.
  * The length prefix is little-endian (it is part of the u32le version
    word's stream) while the string data is UTF-16BIG-endian. Mixing the
    two up produces text that decodes to mojibake rather than an error.
  * A call request is: version, target, "", "", "", function, "", then
    three zero bytes. The empty strings are the argument list's framing
    and the trailing zeros are a count. Omitting the zeros gets a reply
    that never arrives -- the shell accepts the connection and then says
    nothing, which reads as a hung shell rather than a bad message.

If anything about the socket path fails -- no live instance, an
unreadable reply, no answer -- this hands the call to the real
`quickshell ipc` client rather than reporting an error. The fast path is
an optimisation and must never be the reason a keypress does nothing.

Reply size, and why there is no bound here
-----------------------------------------
A reply is a u32-BE byte length, so on paper it can be 4 GiB and this
file used to accumulate a reply of any size into a `bytes` object with
`chunks += part`. Two things changed that.

`clipboard list` is the one reply in the tree big enough to matter, and
it was too big for the socket: 433,018 bytes of UTF-16 at a 750-entry
history, against a 212,992-byte send buffer
(`net.core.wmem_default`). The shell wrote what fitted and closed, so
every client saw a JSON document that ended mid-string. Measured here:
the declared length was constant while the delivered bytes varied
between 219,264 and 255,808, and a hand-written reader to EOF saw the
same truncation as this file -- so nothing here was dropping bytes, the
shell was.

That failure is not merely a truncated reply. Repeated oversized replies
left the shell's IPC server answering *every* subsequent query with
"Not ready to accept queries yet." at exit status 0, which is the same
string tests/run.sh retries through, so it reads as a reload rather than
as a wedged socket. Bounding the reply in Clipboard.qml fixed it without
restarting anything.

So the bound belongs in QML, where the payload's content is known, and
this file only needs to not be the thing that makes it worse: the
accumulator is a bytearray so growing it is linear rather than
quadratic, and a reply that declares more than MAX_REPLY is reported as
an unreadable reply -- which falls back to the real client, as any other
unreadable reply does -- instead of being assembled here first. That
ceiling is 64x the largest reply this tree produces and 19x one socket
send buffer; nothing legitimate reaches it.

Exit status mirrors `quickshell ipc call`: 0 on success, non-zero if the
call could not be made at all.
"""
import glob
import os
import socket
import struct
import subprocess
import sys

EX_TEMPFAIL = 75
TIMEOUT = 2.0
FALLBACK_TIMEOUT = 10.0

REQ_VERSION = 3
RES_VERSION = 5

# A reply longer than this is not assembled. See the module docstring: the
# ceiling exists so a reply too large for the socket is reported rather than
# buffered, and it sits far above anything this shell produces (`clipboard
# list`, the largest, answers in about 65 KB).
MAX_REPLY = 4 << 20


def socket_path(config=None):
    """The live shell's ipc.sock, or None.

    Quickshell indexes instances by md5 of the *config file it was started
    with*, under $XDG_RUNTIME_DIR/quickshell/by-shell/<md5>/. It also keeps
    by-id/<instance>/ and by-pid/<pid>/ views. A restart leaves the old ones
    behind, so the by-shell directory accumulates dead entries -- there were
    13 stale sockets on this machine before this script checked. So: take
    the by-shell directory for our config, and keep only sockets that
    actually accept a connection.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if config is None:
        config = os.environ.get(
            "QUICKSHELL_CONFIG",
            os.path.expanduser("~/.config/quickshell/shell.qml"),
        )
    digest = _md5(config)
    base = f"{runtime}/quickshell/by-shell/{digest}"
    candidates = sorted(glob.glob(f"{base}/*/ipc.sock"))
    # by-id is the fallback in case the by-shell view is missing
    candidates += sorted(glob.glob(f"{runtime}/quickshell/by-id/*/ipc.sock"))

    for path in candidates:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(TIMEOUT)
        try:
            s.connect(path)
            return s, path
        except OSError:
            s.close()
    return None, None


def _md5(text):
    import hashlib
    return hashlib.md5(text.encode()).hexdigest()


def pack(version, *fields):
    out = struct.pack("<I", version)
    for f in fields:
        data = f.encode("utf-16-be")
        if len(data) > 255:
            raise ValueError(f"field too long for a u8 length: {f!r}")
        out += bytes([len(data)]) + data
    return out


# A call request is followed by three zero bytes. Without them the shell
# reads the request as incomplete and simply never replies -- the socket
# accepts the connection and then says nothing at all, which looks exactly
# like a hung shell rather than a malformed message. Found by diffing the
# bytes the real `quickshell ipc call` sends against the bytes this file
# sent, through a proxy in front of the live socket.
CALL_TAIL = b"\x00\x00\x00"


REPLY_TYPE = 5
REPLY_HAS_VALUE = 0
REPLY_VOID = 1


def unpack(data):
    """Decode a reply into (status, value).

        u8    type, 5 for a reply
        u8    status, 0 = has a value, 1 = void
        u32   BYTE length of the string, BIG endian
        ...   that many bytes of UTF-16BE

    The length is a big-endian u32, which is what lets a reply exceed the
    255 bytes a u8 could describe. It was a u8 here first, and every reply
    longer than 127 ASCII characters came back as mojibake: the JSON from
    `battery.getStatus` and `wifi.status` is over that, and both were
    unreadable while short values like "false" looked fine. Nothing errored
    -- the reply simply decoded to the wrong string, which is the worst
    possible failure for something whose job is to be trusted by a keybind.

    Note the mixed endianness: the request's version word is little-endian,
    its reply's length is big-endian, and the payload is UTF-16BE.

    Every return type arrives as a string, including the ones declared
    `: int` -- `battery.getPercentage` replies "66", not 66 -- so nothing
    here needs to know the declared type.

    Returns (status, value) where value is None for a void reply.
    """
    if len(data) < 6:
        raise ValueError("short reply")
    kind, status = data[0], data[1]
    if kind != REPLY_TYPE:
        raise ValueError(f"unexpected reply type {kind}")
    n = int.from_bytes(data[2:6], "big")
    if n > MAX_REPLY:
        raise ValueError(f"reply declares {n} bytes, over the {MAX_REPLY}-byte ceiling")
    if 6 + n > len(data):
        raise ValueError(f"truncated reply: want {n} bytes, have {len(data) - 6}")
    return status, data[6:6 + n].decode("utf-16-be", "replace")


def call(sock, target, function, args=()):
    """Send one call. Returns the decoded fields of the reply."""
    payload = pack(REQ_VERSION, target, "", "", "", function, "")
    for a in args:
        payload += bytes([0])          # argument framing, one per arg
        payload += struct.pack("<I", 0)
    payload += CALL_TAIL
    sock.sendall(payload)

    # bytearray, not bytes: `chunks += part` on a bytes object copies
    # everything received so far on every 64 KiB chunk, which is quadratic
    # in the reply's size. A 65 KB reply is two chunks and does not care --
    # but the whole point of bounding the reply in QML is that its size is
    # not this file's problem, and a buffer that copies itself on every
    # chunk is how that becomes one.
    chunks = bytearray()
    sock.settimeout(TIMEOUT)
    while True:
        try:
            part = sock.recv(65536)
        except socket.timeout:
            break
        if not part:
            break
        chunks += part
        # Bounded on what has arrived rather than on what was declared: a
        # reply the socket will not carry keeps declaring a size it never
        # delivers, so the declared length is no help as a stopping rule.
        if len(chunks) > MAX_REPLY:
            raise ValueError(f"reply exceeds the {MAX_REPLY}-byte ceiling")
        try:
            status, value = unpack(chunks)
        except ValueError:
            continue
        # A void reply is complete at once; a value reply is complete once
        # it carries one.
        if status == REPLY_VOID or value:
            return status, value
    if chunks:
        return unpack(chunks)
    return None, None


def do_show(sock):
    """`quickshell ipc show` equivalent: every target and its functions."""
    status, value = call(sock, "", "show")
    if value:
        print(value)
        return 0
    return 1


def fallback(argv):
    """Hand the call to the real client.

    The fast path is an optimisation, never a dependency. If the socket is
    missing, the reply is not understood, or the shell does not answer,
    the correct behaviour is to do the slow thing rather than to drop the
    keypress -- this is what a user pressing SUPER+N is asking for, and a
    keybind that silently does nothing is the exact failure this repo has
    been bitten by before.
    """
    try:
        done = subprocess.run(
            # `call` is a subcommand of `ipc`, not an optional extra: without
            # it `quickshell` exits 106 with "A subcommand is required", so
            # every keybind's fallback silently failed and reported the wrong
            # error. Found because `clipboard list` overflowed the fast path's
            # socket reply and was the one call that landed here in practice.
            # That reply is bounded now (see the module docstring), so this
            # path is no longer reachable that way -- the reason it was fixed
            # is kept because the next reply too large for the socket will
            # arrive here again, and by then it will be the only clue.
            ["quickshell", "ipc", "call", *argv],
            capture_output=True, text=True, timeout=FALLBACK_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"qs-call: {e}", file=sys.stderr)
        return EX_TEMPFAIL
    if done.stdout:
        sys.stdout.write(done.stdout)
    if done.returncode != 0:
        if done.stderr:
            sys.stderr.write(done.stderr)
        return done.returncode
    return 0


def main(argv):
    if not argv:
        print("usage: qs-call <target> <function> [args...] | qs-call show",
              file=sys.stderr)
        return 2

    sock, path = socket_path()
    if sock is None:
        return fallback(argv)

    try:
        if argv[0] == "show":
            return do_show(sock)

        target = argv[0]
        function = argv[1] if len(argv) > 1 else ""
        if not function:
            print("qs-call: need a function name", file=sys.stderr)
            return 2
        status, value = call(sock, target, function, argv[2:])
    except (OSError, ValueError):
        return fallback(argv)
    finally:
        sock.close()

    if status is None:
        return fallback(argv)
    if value:
        print(value)
    # A void call is a success with nothing to print.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
