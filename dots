#!/usr/bin/env bash
# dots — one entry point for this repo. Provision, link, verify, update.
#
#   ./dots packages [--all|--desktop|--shell|--session|--nvidia|--dev] [--yes] [--dry-run|--plan]
#   ./dots session [--yes] [--dry-run|--plan]   login session only (sddm + sequoia theme, uwsm, graphical target)
#   ./dots link [--yes] [--dry-run|--plan]      symlink configs into ~/.config + ~/.zshrc
#   ./dots fonts [font-file ...]         install vendored (+ given) fonts
#   ./dots apps                          third-party apps (brave, flatpaks; needs a terminal)
#   ./dots check                         verify install + session; make no changes
#   ./dots doctor                        alias for check (actionable verification)
#   ./dots migrate [--dry-run|--pending] apply/list pending repo migrations
#   ./dots state [show|diff|summary|path] inspect managed-state manifest/receipt and drift
#   ./dots lint                          static checks (QML rules, IPC scope, imports)
#   ./dots test [args]                   contract tests (needs a live shell for some)
#   ./dots update [args]                 update the clone and re-link (via bootstrap.sh)
#
# The older per-task scripts still work (scripts/setup.sh, install.sh,
# scripts/install-fonts.sh, install-software, bootstrap.sh); this is the
# documented front end. It never runs as root — sudo stays per-command
# inside the scripts below.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
. "$REPO_DIR/scripts/lib.sh"

usage() {
    sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

[ "$(id -u)" -eq 0 ] && die "Refusing to run as root. Run as your normal user; sudo is used per-command."

# Global flags may precede or follow the subcommand; re-emit them for the
# sub-script. Everything else passes through untouched.
EXTRA=()
POS=()
for arg in "$@"; do
    case "$arg" in
        --dry-run|--plan) EXTRA+=(--dry-run) ;;
        -y|--yes)         EXTRA+=(--yes) ;;
        *)                POS+=("$arg") ;;
    esac
done

CMD="${POS[0]:---help}"
REST=("${POS[@]:1}")

case "$CMD" in
    packages)
        if [ "${#REST[@]}" -eq 0 ]; then
            REST=(--desktop --shell --session)
        fi
        bash "$REPO_DIR/scripts/setup.sh" "${REST[@]}" --no-link "${EXTRA[@]}" ;;
    session)
        bash "$REPO_DIR/scripts/setup.sh" --session --no-link "${EXTRA[@]}" "${REST[@]}" ;;
    link)
        bash "$REPO_DIR/install.sh" "${EXTRA[@]}" "${REST[@]}" ;;
    fonts)
        bash "$REPO_DIR/scripts/install-fonts.sh" "${REST[@]}" ;;
    apps)
        bash "$REPO_DIR/install-software" "${EXTRA[@]}" ;;
    check|doctor)
        bash "$REPO_DIR/install.sh" --check ;;
    migrate)
        bash "$REPO_DIR/scripts/migrate.sh" "${EXTRA[@]}" "${REST[@]}" ;;
    state|manifest)
        # shellcheck disable=SC1091
        . "$REPO_DIR/scripts/lib/manifest.sh"
        # shellcheck disable=SC1091
        . "$REPO_DIR/scripts/lib/state.sh"
        sub="${REST[0]:-summary}"
        case "$sub" in
            show) dots_manifest_show ;;
            diff) dots_manifest_diff "$REPO_DIR" ;;
            summary) dots_manifest_summary ;;
            path) echo "$(dots_state_manifest_file)" ;;
            *) err "unknown state subcommand: $sub (use show|diff|summary|path)"; exit 2 ;;
        esac
        ;;
    lint)
        bash "$REPO_DIR/scripts/lint.sh" "${REST[@]}" ;;
    test)
        bash "$REPO_DIR/tests/run.sh" "${REST[@]}" ;;
    update)
        bash "$REPO_DIR/bootstrap.sh" "${EXTRA[@]}" "${REST[@]}" ;;
    -h|--help|help)
        usage ;;
    *)
        err "unknown command: $CMD"
        usage >&2
        exit 2 ;;
esac
